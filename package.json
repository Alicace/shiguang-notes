{
  "name": "notes",
  "private": true,
  "version": "1.12.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alicace/shiguang-notes.git"
  },
  "homepage": "https://github.com/Alicace/shiguang-notes",
  "bugs": {
    "url": "https://github.com/Alicace/shiguang-notes/issues"
  },
  "type": "module",
  "scripts": {
    "backend": "tsx server/index.ts",
    "backend:watch": "tsx watch server/index.ts",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --port 15173",
    "dev:docker": "vite --host 0.0.0.0 --port 15173",
    "build": "npm run typecheck && npm run build:server && vite build",
    "build:static": "npm run typecheck:app && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "npm run typecheck:app && npm run typecheck:server && npm run typecheck:feedback",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:feedback": "tsc --noEmit -p tsconfig.feedback.json",
    "test": "npm run test:feedback",
    "test:feedback": "npm run test:frontend && npm run test:backend && npm run test:dsh-plugin",
    "test:frontend": "node --import tsx --test frontend/tests/*.test.ts",
    "test:backend": "node --import tsx --test --test-concurrency=1 backend/tests/*.test.ts",
    "test:dsh-plugin": "node --import tsx --test --test-concurrency=1 dsh-plugin/tests/*.test.ts",
    "benchmark:input": "node scripts/benchmark-input-latency.mjs",
    "preview": "vite preview",
    "fnos:m0:build": "node fnos/m0/build.mjs",
    "fnos:m0:pack": "node fnos/m0/build.mjs --pack",
    "fnos:m0:dev": "node fnos/m0/dev.mjs",
    "fnos:build": "node fnos/native/build.mjs",
    "fnos:pack": "node fnos/native/build.mjs --pack",
    "fnos:manifest": "node scripts/make-update-manifest.mjs",
    "fnos:dev": "node fnos/native/dev.mjs",
    "fnos:test": "node --test --test-concurrency=1 fnos/native/*.test.mjs && node --import tsx --test fnos/m0/png.test.ts fnos/m0/diagnostics.test.ts",
    "fnos:m0:test": "node --test fnos/m0/server.test.mjs && node --import tsx --test fnos/m0/png.test.ts fnos/m0/diagnostics.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@trimjs/web-app": "0.5.0",
    "express": "^5.2.1",
    "html-to-image": "1.11.13",
    "multer": "^2.1.1",
    "playwright": "^1.58.2",
    "qiniu": "^7.15.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^7.1.2"
  }
}
